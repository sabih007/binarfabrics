# ===========================================================================
# BinAr Fabrics — environment
# Copy to `.env` and fill in. Never commit `.env`.
# ===========================================================================

# --- Database (required) ---------------------------------------------------
# Supabase: Project Settings -> Database -> Connection string -> "Transaction"
# Neon:     Dashboard -> Connection Details -> Pooled connection string
#
# Always set sslmode explicitly. A bare `sslmode=require` makes node-postgres
# print a deprecation warning, because today it silently means `verify-full`
# but will mean something weaker in pg v9. Pick the one you actually want:
#
#   uselibpqcompat=true&sslmode=require
#       Encrypted, certificate not verified. Required for Supabase's pooler,
#       which presents a self-signed chain — plain verify-full fails against
#       it with "self-signed certificate in certificate chain".
#   sslmode=verify-full
#       Encrypted + certificate and hostname verified. The stronger option,
#       but only works where the host's cert chains to a public CA. For
#       Supabase, pair it with their CA bundle (Project Settings -> Database
#       -> SSL Configuration) as sslmode=verify-full&sslrootcert=/path/ca.crt
#   sslmode=disable
#       Postgres on localhost with no TLS configured.
#
# Use the Transaction pooler (port 6543) here; Session pooler (5432) in
# DIRECT_URL below, since the transaction pooler can't run the DDL that
# `prisma db push` and migrations need.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?uselibpqcompat=true&sslmode=require"
# Unpooled/direct connection, used for migrations. Supabase & Neon both give
# you one; leave blank if your host has no separate direct URL.
DIRECT_URL=""

# --- Admin sessions (required) ---------------------------------------------
# Any long random string. Generate one with:  openssl rand -base64 32
AUTH_SECRET=""

# Seeded owner account for /admin. Change the password after first sign-in.
ADMIN_EMAIL="owner@binarfabrics.com"
ADMIN_PASSWORD=""
ADMIN_NAME="Store Owner"

# --- Site ------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Card payments (optional) ----------------------------------------------
# Leave blank to run cash-on-delivery only; the card option then stays hidden.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_ENABLED="false"

# --- Transactional email (optional) ----------------------------------------
# Leave blank and nothing is emailed; orders and messages still save to the DB.
RESEND_API_KEY=""
MAIL_FROM="BinAr Fabrics <onboarding@resend.dev>"
MAIL_TO="orders@binarfabrics.com"

# --- Counter / point of sale (optional) ------------------------------------
# Printed at the top of every receipt from /admin/pos. Leave a line blank and
# it is simply omitted from the slip.
NEXT_PUBLIC_STORE_NAME="BinAr Fabrics"
NEXT_PUBLIC_STORE_ADDRESS=""
NEXT_PUBLIC_STORE_PHONE=""
NEXT_PUBLIC_STORE_NTN=""
NEXT_PUBLIC_RECEIPT_FOOTER="Thank you for shopping with us!"

# Prefills the GST box at the till, as a percentage. "18" means 18%. The
# cashier can still change it per sale; each sale stores the rate it used.
NEXT_PUBLIC_POS_TAX_RATE="0"

# The shop's clock, as minutes ahead of UTC — Pakistan (PKT, UTC+5) is 300.
# Day boundaries for "today's takings" and the sales date filter are anchored
# to this, so the figure doesn't shift with the server's or browser's timezone.
NEXT_PUBLIC_SHOP_UTC_OFFSET="300"
