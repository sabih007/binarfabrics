# ===========================================================================
# BinAr Fabrics — mobile app environment
# Copy to `.env`. Only EXPO_PUBLIC_* values reach the app bundle, so nothing
# secret belongs in here: the app talks to the website's API, and the API is
# the only thing that holds database and Stripe credentials.
# ===========================================================================

# Where the store's Next.js API lives — no trailing slash.
#
#   iOS simulator / web      http://localhost:3000
#   Android emulator         http://10.0.2.2:3000
#   A real phone on Wi-Fi    http://<your computer's LAN IP>:3000
#   Production               https://your-live-site.com
#
# A physical device cannot reach `localhost` — that points at the phone itself.
EXPO_PUBLIC_API_URL="http://localhost:3000"
