// ===========================================================================
// BinAr Fabrics — database schema
// Postgres (Supabase / Neon / any Postgres). Run `npm run db:push` after edits.
// ===========================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// --------------------------------------------------------------------- shop

model Category {
  id        String    @id @default(cuid())
  slug      String    @unique
  name      String
  sub       String?
  /// Generated-artwork hints, used when a category has no image
  pattern   String    @default("plain")
  colors    String[]  @default([])
  image     String?
  /// Where the homepage tile links to. Defaults to /shop?cat=<slug>.
  href      String?
  sortOrder Int       @default(0)
  active    Boolean   @default(true)
  showOnHome Boolean  @default(true)
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([active, sortOrder])
}

model Product {
  id          String   @id @default(cuid())
  /// URL + cart identifier, e.g. "bl-101"
  slug        String   @unique
  name        String
  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  collection  String
  fabric      String
  /// Whole PKR rupees — never paisa.
  price       Int
  oldPrice    Int?
  pieces      Int      @default(1)
  pattern     String   @default("plain")
  colors      String[] @default([])
  sizes       String[] @default([])
  badge       String?
  rating      Float    @default(0)
  reviews     Int      @default(0)
  description String
  image       String?
  images      String[] @default([])
  stock       Int      @default(0)
  /// Stock at or below this shows the "low" badge automatically.
  lowStockAt  Int      @default(5)
  active      Boolean  @default(true)
  featured    Boolean  @default(false)
  sortOrder   Int      @default(0)
  items       OrderItem[]
  saleItems   SaleItem[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([active, categoryId])
  @@index([active, featured])
  @@index([fabric])
  @@index([collection])
}

// ------------------------------------------------------------------- orders

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentMethod {
  COD
  CARD
}

enum PaymentStatus {
  UNPAID
  PAID
  REFUNDED
  FAILED
}

model Order {
  id            String        @id @default(cuid())
  /// Human-facing reference, e.g. "BA-10234"
  number        String        @unique
  status        OrderStatus   @default(PENDING)
  paymentMethod PaymentMethod @default(COD)
  paymentStatus PaymentStatus @default(UNPAID)

  customerName  String
  phone         String
  email         String?
  address       String
  city          String
  postalCode    String?
  notes         String?

  /// All money in whole PKR rupees, computed server-side at checkout.
  subtotal      Int
  shipping      Int
  discount      Int           @default(0)
  total         Int

  stripeSessionId       String? @unique
  stripePaymentIntentId String?

  items     OrderItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([status, createdAt])
  @@index([phone])
}

model OrderItem {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  /// Nullable so deleting a product never destroys order history.
  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  /// Snapshot of the product at the time of purchase.
  slug      String
  name      String
  price     Int
  qty       Int
  color     String?
  size      String?
  image     String?

  @@index([orderId])
}

// ----------------------------------------------------------------- counter

/// Walk-in sales rung up at the shop counter in /admin/pos.
///
/// Deliberately separate from `Order`: a counter sale has no address and no
/// delivery lifecycle, but it does have a cashier, tendered cash and change.
/// Folding the two together would mean a nullable address on every online
/// order and a SHIPPED status that can never apply to a till receipt.

enum SaleStatus {
  COMPLETED
  VOIDED
}

enum SalePayment {
  CASH
  CARD
  MIXED
}

model Sale {
  id      String      @id @default(cuid())
  /// Human-facing reference printed on the receipt, e.g. "BA-S-1001"
  number  String      @unique
  status  SaleStatus  @default(COMPLETED)
  payment SalePayment @default(CASH)

  /// Nullable so removing a staff account never destroys sales history;
  /// `cashierName` is the snapshot that keeps old receipts printable.
  cashierId   String?
  cashier     AdminUser? @relation(fields: [cashierId], references: [id], onDelete: SetNull)
  cashierName String

  /// Walk-ins are usually anonymous — both are optional.
  customerName String?
  phone        String?

  /// All money in whole PKR rupees, recomputed server-side.
  subtotal Int
  discount Int @default(0)
  /// Tax rate in basis points (1800 = 18.00%), snapshotted per sale so a
  /// later rate change never rewrites an old receipt.
  taxRate  Int @default(0)
  tax      Int @default(0)
  total    Int

  /// What was handed over. Cash-only sales leave `cardAmount` null and
  /// vice versa; MIXED sets both.
  cashGiven  Int?
  cardAmount Int?
  change     Int @default(0)

  notes      String?
  voidedAt   DateTime?
  voidReason String?

  items     SaleItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([status, createdAt])
  @@index([createdAt])
  @@index([phone])
}

model SaleItem {
  id     String @id @default(cuid())
  saleId String
  sale   Sale   @relation(fields: [saleId], references: [id], onDelete: Cascade)

  /// Both null for a manual line — something typed straight into the till
  /// that isn't in the catalogue. Catalogue lines carry the product so stock
  /// can be decremented and returned on a void.
  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  slug      String?

  /// Snapshot of the line at the moment of sale.
  name  String
  price Int
  qty   Int
  color String?
  size  String?

  @@index([saleId])
}

// ---------------------------------------------------------------- messaging

enum MessageStatus {
  NEW
  READ
  ARCHIVED
}

model ContactMessage {
  id          String        @id @default(cuid())
  name        String
  phone       String
  email       String?
  topic       String
  orderNumber String?
  message     String
  status      MessageStatus @default(NEW)
  ip          String?
  createdAt   DateTime      @default(now())

  @@index([status, createdAt])
}

model Subscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  active    Boolean  @default(true)
  source    String?
  createdAt DateTime @default(now())
}

// -------------------------------------------------------------------- admin

enum AdminRole {
  OWNER
  STAFF
}

model AdminUser {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  passwordHash String
  role         AdminRole @default(STAFF)
  active       Boolean   @default(true)
  lastLoginAt  DateTime?
  sales        Sale[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}
